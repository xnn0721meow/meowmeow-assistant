{
  "name": "meowmeow-assistant",
  "version": "0.1.0",
  "description": "MeowMeow Assistant — a desktop study companion with a transparent Live2D mascot and local focus detection.",
  "main": "./out/main/index.js",
  "author": {
    "name": "xnn0721meow",
    "email": "1246597997@qq.com"
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xnn0721meow/meowmeow-assistant.git"
  },
  "bugs": {
    "url": "https://github.com/xnn0721meow/meowmeow-assistant/issues"
  },
  "homepage": "https://github.com/xnn0721meow/meowmeow-assistant#readme",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.0",
    "@pixi/sound": "^6.0.1",
    "pixi.js": "^8.13.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "untitled-pixi-live2d-engine": "^1.4.0"
  },
  "devDependencies": {
    "@swc/core": "^1.13.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "dev.meowmeow.assistant",
    "productName": "MeowMeow Assistant",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "@swc/core@1.16.21": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true
  }
}
